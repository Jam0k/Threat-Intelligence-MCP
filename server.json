{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.Jam0k/threatcluster",
  "description": "Live threat intel for agents: incidents, actors, CVEs with KEV/EPSS, ransomware leak-site victims.",
  "status": "active",
  "repository": {
    "url": "https://github.com/Jam0k/Threat-Intelligence-MCP",
    "source": "github"
  },
  "version": "0.2.4",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "threatcluster-mcp",
      "version": "0.2.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "THREATCLUSTER_API_KEY",
          "description": "ThreatCluster API key (tc_live_... / tc_agent_...). Free keys: https://threatcluster.io/api",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "THREATCLUSTER_API_BASE",
          "description": "API base URL",
          "isRequired": false,
          "isSecret": false,
          "default": "https://threatcluster.io/api/public/v1",
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://threatcluster.io/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "ThreatCluster API key. Free keys: https://threatcluster.io/api",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
