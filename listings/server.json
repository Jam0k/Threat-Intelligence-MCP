{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Jam0k/threatcluster",
  "description": "Live threat intelligence: incident clusters, threat actors, CVEs with KEV/EPSS, leak-site victims.",
  "repository": {
    "url": "https://github.com/Jam0k/Threat-Intelligence-MCP",
    "source": "github"
  },
  "websiteUrl": "https://threatcluster.io/integrations/mcp",
  "version": "0.2.7",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://threatcluster.io/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "threatcluster-mcp",
      "version": "0.2.7",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "THREATCLUSTER_API_KEY",
          "description": "ThreatCluster API key (tc_live_... / tc_agent_...). Free keys: https://threatcluster.io/api",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "THREATCLUSTER_API_BASE",
          "description": "API base URL",
          "isRequired": false,
          "isSecret": false,
          "default": "https://threatcluster.io/api/public/v1",
          "format": "string"
        }
      ]
    },
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "threatcluster-mcp",
      "version": "0.2.7",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "THREATCLUSTER_API_KEY",
          "description": "ThreatCluster API key (tc_live_... / tc_agent_...). Free keys: https://threatcluster.io/api",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
